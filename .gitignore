# Build output / local tooling
_site/
.venv/
__pycache__/
.DS_Store

# Secrets and credentials: never commit these (see AGENTS.md)
.env
.env.*
*.pem
*.key
*.p12
*.pfx
credentials*.json
service-account*.json
*-sa.json
client_secret*.json
token*.json
.secrets/

# Spreadsheet exports may contain personal data from the club's form tabs
*.xlsx
*.xls
*.csv
*.ods
exports/

# Test tooling (Playwright, Node is test-only)
node_modules/
_site-test/
_site-smoke/
test-results/
playwright-report/
blob-report/
# Visual baselines: only Linux (CI) baselines are committed
tests/__screenshots__/**/*-darwin.png
tests/__screenshots__/**/*-win32.png
